# =============================================================================
# RAI Healthcare Diagnostic Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Required: AWS Configuration
# -----------------------------------------------------------------------------

# AWS region where resources will be deployed
export AWS_REGION=us-east-1

# Your 12-digit AWS account ID (find via: aws sts get-caller-identity --query Account --output text)
export AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# -----------------------------------------------------------------------------
# Required: S3 Configuration
# -----------------------------------------------------------------------------

# S3 bucket name for the data lake (must be globally unique)
# Convention: rai-healthcare-demo-<account-id>-<region>
export S3_BUCKET=rai-healthcare-demo-YOUR_ACCOUNT_ID-us-east-1

# S3 key prefix for all project objects
export S3_PREFIX=rai-healthcare-demo

# -----------------------------------------------------------------------------
# Required: Bedrock Configuration
# -----------------------------------------------------------------------------

# Bedrock foundation model ID for clinical decision support
# Ensure model access is granted in the Bedrock console
# The "us." prefix is required for cross-region inference profiles
export BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Confidence threshold below which physician review is mandatory.
# A FRACTION in [0.50, 1.0] — not a percent. The scripts, the Lambda and the agent
# runtime refuse to start if it is outside that range (so 70 fails, 0.70 works).
# Terraform's confidence_threshold variable is the percent form (70) and is divided
# by 100 before it reaches the application.
export CONFIDENCE_THRESHOLD=0.70

# -----------------------------------------------------------------------------
# Automated Reasoning Guardrail
# Set these values after running: python scripts/setup_guardrail.py
# -----------------------------------------------------------------------------

# Guardrail ID printed by scripts/setup_guardrail.py
export GUARDRAIL_ID=

# Guardrail version printed by scripts/setup_guardrail.py (an immutable numbered version)
export GUARDRAIL_VERSION=DRAFT
# Automated Reasoning policy attached to the script guardrail, printed by
# scripts/setup_guardrail.py. The agent runtime role authorizes
# bedrock:InvokeAutomatedReasoningPolicy on this exact versioned policy ARN.
export AR_POLICY_ID=
export AR_POLICY_VERSION=

# -----------------------------------------------------------------------------
# Required for the agent deploy: clinical guidelines Knowledge Base
# -----------------------------------------------------------------------------

# Knowledge Base ID from docs/deployment.md Step 4. The agent retrieves guideline
# passages from it, and the runtime role may call bedrock:Retrieve on it only.
export KNOWLEDGE_BASE_ID=

# Alarm email notifications are configured with the Terraform variable alarm_email
# (infra/terraform.tfvars), not here.

# -----------------------------------------------------------------------------
# Optional: Demo 1 (bias, explainability and LLM evaluation)
# -----------------------------------------------------------------------------

# SageMaker AI MLflow App ARN, printed by scripts/setup_mlflow.py. When set,
# scripts 02 and 04 log their results to it.
# export MLFLOW_TRACKING_ARN=

# Instance type of the bias and SHAP SageMaker AI Processing job
# export BIAS_JOB_INSTANCE_TYPE=ml.t3.medium

# Override the AWS scikit-learn container image. Needed only outside us-east-1,
# us-east-2 and us-west-2; see
# https://docs.aws.amazon.com/sagemaker/latest/dg-ecr-paths/sagemaker-algo-docker-registry-paths.html
# export BIAS_JOB_IMAGE_URI=

